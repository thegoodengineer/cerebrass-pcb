# Copy to .env (never commit .env). The dashboard server reads this file; keys never reach the browser.

# --- Cerebras (required for live runs) ---------------------------------------------------
CEREBRAS_API_KEY=
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# CEREBRAS_MODEL=moonshotai-kimi-k3.1-pro-trial

# --- Baseline for the speed benchmark: any OpenAI-compatible chat.completions endpoint ----
# The model must support tool calling and streaming.
BASELINE_BASE_URL=
BASELINE_MODEL=
BASELINE_API_KEY=
BASELINE_LABEL=Standard GPU endpoint

# --- Optional -----------------------------------------------------------------------------
# CLAWBOARD_PYTHON=python3            # interpreter used for the PCB tools
# CLAWBOARD_RUNS_DIR=                 # working copies + reports (default: OS temp dir / clawboard-runs)
# KICAD_CLI=                          # path to kicad-cli if it is not on PATH (enables the KiCad oracle)
# PORT=3000
